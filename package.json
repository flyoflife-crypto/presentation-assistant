{
  "name": "presentation-assistant-pro",
  "version": "1.0.0",
  "description": "A macOS Electron desktop application for real-time presentation coaching",
  "main": "dist/electron/main.js",
  "author": "Presentation Assistant Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "webpack serve --config webpack.renderer.config.ts --mode development",
    "dev:electron": "webpack --config webpack.electron.config.ts --mode development && electron .",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "webpack --config webpack.renderer.config.ts --mode production",
    "build:electron": "webpack --config webpack.electron.config.ts --mode production",
    "package": "npm run build && electron-builder --mac --arm64",
    "package:universal": "npm run build && electron-builder --mac --universal",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "electron-store": "^8.1.0",
    "keytar": "^7.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4",
    "p-limit": "^5.0.0",
    "eventemitter3": "^5.0.1",
    "webgazer": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron-builder": "^24.9.1",
    "eslint": "^8.54.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.3",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.presentationassistant.pro",
    "productName": "Presentation Assistant Pro",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "default",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
